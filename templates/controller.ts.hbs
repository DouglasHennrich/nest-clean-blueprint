import { Body, Controller, HttpCode, HttpStatus, Post } from '@nestjs/common';
import { ZodValidationPipe } from '@/@shared/pipes/zod-validation.pipe';
import { T{{Action}}{{Entity}}Service } from '../services/{{action}}-{{entity}}.service';
import { I{{Entity}}Presenter } from '../presenters/{{entity}}.presenter';
import { {{action}}{{Entity}}DtoSchema, T{{Action}}{{Entity}}Dto } from '../dto/{{entity}}.dto';

// Convention: full path lives in @Controller. Swap @Post/@Body for
// @Get/@Patch/@Delete + @Param/@Query to match this action's HTTP verb.
@Controller('{{entitiesPlural}}')
export class {{Action}}{{Entity}}Controller {
